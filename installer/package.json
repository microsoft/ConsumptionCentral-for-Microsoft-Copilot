{
  "name": "consumption-central-installer",
  "version": "0.1.0",
  "description": "Consumption Central installer. Sets up the Consumption Central data pipeline and semantic model in Microsoft Fabric: app registration, Key Vault secret, workspace, Lakehouse, notebooks, pipeline, schedule and first load.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "consumption-central-installer": "bin/consumption-central-installer.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node bin/consumption-central-installer.js",
    "build:exe": "node packaging/build-exe.js",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@inquirer/prompts": "^8.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
