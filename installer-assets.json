      "secret": { "kind": "clientSecret", "name": "consumption-central-azure-client-secret" },
      "reads": [],
      "writes": ["azure_ai_spend", "azure_ai_tokens", "copilot_payg_spend", "azure_deployment_health", "azure_solution_spend", "azure_billing_reconciliation"],
      "landing": null,
      "loadSummary": null,
      "run": "pipeline",
      "exclusiveGroup": null
    },
    {
      "key": "studioConsumption",
