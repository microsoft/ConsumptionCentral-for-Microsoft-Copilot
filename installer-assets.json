{
  "$comment": "What the Consumption Central installer deploys. Field meanings: CONTRIBUTING.md#installer-asset-manifest. Enforced by docs/scripts/test_installer_assets.py.",
  "version": 1,
  "templates": {
    "fabric": {
      "path": "2. Fabric/Consumption Central - Fabric.pbit",
      "parameters": ["FabricSQLEndpoint", "LakehouseName", "BillingPeriodWeeks", "CreditRate", "PrepaidCreditRate", "PrepaidCreditBalance", "GitHubBusinessSeatPrice", "GitHubEnterpriseSeatPrice"]
    },
    "vivaDirect": {
      "path": "3. Viva Direct/Consumption Central - Viva Direct.pbit",
      "parameters": ["BillingPeriodWeeks", "VivaPartitionId", "VivaQueryId", "CoworkRatePerCredit", "CoworkPrepaidRatePerCredit", "StudioRatePerCredit", "StudioPrepaidRatePerCredit", "CapacityPackCredits", "GitHubRatePerCredit", "GitHubBusinessSeatPrice", "GitHubEnterpriseSeatPrice", "GitHubAllowanceChangeDate", "GitHubBusinessStandardCredits", "GitHubEnterpriseStandardCredits", "DataFolder"]
    },
    "localCsv": {
      "path": "1. Local CSV/Consumption Central - Local CSV.pbit",
      "parameters": ["DataFolder", "BillingPeriodWeeks", "CreditRate", "PrepaidCreditRate", "PrepaidCreditBalance", "GitHubBusinessSeatPrice", "GitHubEnterpriseSeatPrice"]
    }
  },
