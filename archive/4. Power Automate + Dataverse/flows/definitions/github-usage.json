{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Daily": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2024-01-01T03:00:00Z"
      }
    }
  },
  "actions": {
    "Initialise_TenantId": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "TenantId",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialise_ClientId": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialise_TenantId": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "ClientId",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialise_DataverseUrl": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialise_ClientId": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "DataverseUrl",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialise_ContinuationToken": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialise_DataverseUrl": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "ContinuationToken",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Days": {
      "type": "Compose",
      "runAfter": {
        "Initialise_ContinuationToken": [
          "Succeeded"
        ]
      },
      "inputs": "@range(0, 2)"
    },
    "For_each_day": {
      "type": "Foreach",
      "runAfter": {
        "Days": [
          "Succeeded"
        ]
      },
      "foreach": "@map(outputs('Days'), item => formatDateTime(addDays(utcNow(), mul(-1, item)), 'yyyy-MM-dd'))",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Get_secret": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_keyvault",
              "operationId": "GetSecret",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault"
            },
            "parameters": {
              "secretName": "consumption-central-github-token"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Fetch": {
          "type": "Http",
          "runAfter": {
            "Get_secret": [
              "Succeeded"
            ]
          },
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/enterprises/{enterprise}/settings/billing/usage?fromDate=@{items('For_each_day')}&toDate=@{items('For_each_day')}",
            "headers": {
              "Authorization": "Bearer @{body('Get_secret')?['value']}",
              "Accept": "application/json"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "For_each_row": {
          "type": "Foreach",
          "runAfter": {
            "Fetch": [
              "Succeeded"
            ]
          },
          "foreach": "@coalesce(body('Fetch')?['value'], json('[]'))",
          "actions": {
            "Upsert_row": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecordWithAlternateKey",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "cc_githubaiusages",
                  "alternateKey": "cc_rowkey",
                  "item": {
                    "cc_rowkey": "@{concat(coalesce(string(items('For_each_row')?['Usage_Date']), '')'|'coalesce(string(items('For_each_row')?['Username']), '')'|'coalesce(string(items('For_each_row')?['Sku']), '')'|'coalesce(string(items('For_each_row')?['Model']), ''))}",
                    "cc_name": "@{first(take(concat(coalesce(string(items('For_each_row')?['Usage_Date']), 'row')), 400))}",
                    "cc_loadedon": "@{utcNow()}",
                    "cc_payloadjson": "@{string(items('For_each_row'))}",
                    "cc_usagedate": "@{items('For_each_row')?['Usage_Date']}",
                    "cc_username": "@{items('For_each_row')?['Username']}",
                    "cc_sku": "@{items('For_each_row')?['Sku']}",
                    "cc_model": "@{items('For_each_row')?['Model']}",
                    "cc_credits": "@{items('For_each_row')?['Credits']}",
                    "cc_grossamount": "@{items('For_each_row')?['Gross_Amount']}",
                    "cc_discountamount": "@{items('For_each_row')?['Discount_Amount']}",
                    "cc_netamount": "@{items('For_each_row')?['Net_Amount']}",
                    "cc_costcentre": "@{items('For_each_row')?['Cost_Centre']}",
                    "cc_organization": "@{items('For_each_row')?['Organization']}"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
