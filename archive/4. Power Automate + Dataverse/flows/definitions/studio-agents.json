{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Daily": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2024-01-01T03:00:00Z"
      }
    }
  },
  "actions": {
    "Initialise_TenantId": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "TenantId",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialise_ClientId": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialise_TenantId": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "ClientId",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialise_DataverseUrl": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialise_ClientId": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "DataverseUrl",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialise_ContinuationToken": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialise_DataverseUrl": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "ContinuationToken",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Days": {
      "type": "Compose",
      "runAfter": {
        "Initialise_ContinuationToken": [
          "Succeeded"
        ]
      },
      "inputs": "@range(0, 7)"
    },
    "For_each_day": {
      "type": "Foreach",
      "runAfter": {
        "Days": [
          "Succeeded"
        ]
      },
      "foreach": "@map(outputs('Days'), item => formatDateTime(addDays(utcNow(), mul(-1, item)), 'yyyy-MM-dd'))",
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Reset_continuation": {
          "type": "SetVariable",
          "runAfter": {},
          "inputs": {
            "name": "ContinuationToken",
            "value": ""
          }
        },
        "Until_page": {
          "type": "Until",
          "runAfter": {
            "Reset_continuation": [
              "Succeeded"
            ]
          },
          "expression": "@equals(variables('ContinuationToken'), '')",
          "limit": {
            "count": 1000,
            "timeout": "PT1H"
          },
          "actions": {
            "Fetch": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connectionName": "shared_webcontents_1",
                  "operationId": "InvokeHttp",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
                },
                "parameters": {
                  "request/method": "GET",
                  "request/url": "@{concat('https://api.powerplatform.com/licensing/entitlements/MCSMessages/resources?api-version=2024-10-01&pageSize=5000&includeFields=users%2Ctags%2CasOfDate&fromDate=', items('For_each_day'), '&toDate=', items('For_each_day'), '&continuationtoken=', variables('ContinuationToken'))}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "For_each_row": {
              "type": "Foreach",
              "runAfter": {
                "Fetch": [
                  "Succeeded"
                ]
              },
              "foreach": "@coalesce(first(body('Fetch')?['value'])?['resources'], body('Fetch')?['value'], json('[]'))",
              "actions": {
                "Upsert_row": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecordWithAlternateKey",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "cc_studioagents",
                      "alternateKey": "cc_rowkey",
                      "item": {
                        "cc_rowkey": "@{concat(coalesce(string(items('For_each_row')?['snapshot_month']), '')'|'coalesce(string(items('For_each_row')?['Agent_Id']), '')'|'coalesce(string(items('For_each_row')?['Billable_Feature']), '')'|'coalesce(string(items('For_each_row')?['Channel']), '')'|'coalesce(string(items('For_each_row')?['LLM_Model']), '')'|'coalesce(string(items('For_each_row')?['Scenario_Name']), '')'|'coalesce(string(items('For_each_row')?['Environment_Id']), ''))}",
                        "cc_name": "@{first(take(concat(coalesce(string(items('For_each_row')?['snapshot_month']), 'row')), 400))}",
                        "cc_loadedon": "@{utcNow()}",
                        "cc_payloadjson": "@{string(items('For_each_row'))}",
                        "cc_agentname": "@{items('For_each_row')?['Agent_Name']}",
                        "cc_agentid": "@{items('For_each_row')?['Agent_Id']}",
                        "cc_product": "@{items('For_each_row')?['Product']}",
                        "cc_billablefeature": "@{items('For_each_row')?['Billable_Feature']}",
                        "cc_billedcredit": "@{items('For_each_row')?['Billed_credit']}",
                        "cc_nonbilledcredit": "@{items('For_each_row')?['Non_billed_credit']}",
                        "cc_channel": "@{items('For_each_row')?['Channel']}",
                        "cc_knowledgesources": "@{items('For_each_row')?['Knowledge_Sources']}",
                        "cc_toolused": "@{items('For_each_row')?['Tool_Used']}",
                        "cc_llmmodel": "@{items('For_each_row')?['LLM_Model']}",
                        "cc_scenarioname": "@{items('For_each_row')?['Scenario_Name']}",
                        "cc_environmentid": "@{items('For_each_row')?['Environment_Id']}",
                        "cc_environmentname": "@{items('For_each_row')?['Environment_Name']}",
                        "cc_snapshotmonth": "@{formatDateTime(items('For_each_day'), 'yyyy-MM')}"
                      }
                    }
                  }
                }
              }
            },
            "Set_continuation": {
              "type": "SetVariable",
              "runAfter": {
                "For_each_row": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "name": "ContinuationToken",
                "value": "@{coalesce(body('Fetch')?['continuationtoken'], '')}"
              }
            }
          }
        }
      }
    }
  }
}
