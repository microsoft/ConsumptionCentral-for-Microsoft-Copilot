{
  "name": "consumption-central-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:file": "tsc -b && vite build --mode file",
    "build:demo": "python ../demo/scripts/prepare-fixtures.py --out demo-public/sample && tsc -b && vite build --mode demo",
    "build:report-demo": "python ../demo/consumption-central-report-src/scripts/build.py && vite build --config vite.report-demo.config.ts",
    "test:report-demo": "tsc -p tsconfig.report-demo.json && node scripts/test-report-demo.mjs",
    "test:report-demo:browser": "node scripts/test-report-demo-browser.mjs",
    "lint": "eslint .",
    "prepare-sample": "node scripts/prepare-sample.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/managed-apps": "^0.5.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/managed-apps-cli": "0.29.0",
    "@microsoft/managed-apps-vite-plugin": "^0.3.11",
    "@microsoft/rayfin-cli": "^1.35.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
